  "components": {
    "schemas": {
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{2,30}$"
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "categoria": {
            "enum": [
              "balanceado",
              "probiotico",
              "quimico",
              "fertilizante",
              "otro"
            ]
          },
          "unidad": {
            "enum": [
              "kg",
              "l",
              "unidad"
            ]
          },
          "stock_minimo": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          }
        },
        "required": [
          "sku",
          "nombre",
          "categoria",
          "unidad",
          "stock_minimo"
        ]
      },
      "LotInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "producto_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "codigo_lote": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "cantidad": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "costo_unitario": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "vence_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "producto_id",
          "codigo_lote",
          "cantidad",
          "costo_unitario"
        ]
      },
      "MovementInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lote_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "tipo": {
            "enum": [
              "entrada",
              "salida"
            ]
          },
          "cantidad": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "referencia": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "motivo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "required": [
          "lote_id",
          "tipo",
          "cantidad",
          "referencia",
          "motivo"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "message"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{2,30}$"
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "categoria": {
            "enum": [
              "balanceado",
              "probiotico",
              "quimico",
              "fertilizante",
              "otro"
            ]
          },
          "unidad": {
            "enum": [
              "kg",
              "l",
              "unidad"
            ]
          },
          "stock_minimo": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "activo": {
            "type": "boolean"
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sku",
          "nombre",
          "categoria",
          "unidad",
          "stock_minimo",
          "id",
          "activo",
          "stock"
        ]
      },
      "Lot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "producto_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "codigo_lote": {
            "type": "string"
          },
          "cantidad_inicial": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "cantidad_actual": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "costo_unitario": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "fecha_ingreso": {
            "type": "string",
            "format": "date-time"
          },
          "vence_at": {
            "type": "string",
            "format": "date-time"
          },
          "producto": {
            "$ref": "#/components/schemas/Product"
          }
        },
        "required": [
          "id",
          "producto_id",
          "codigo_lote",
          "cantidad_actual"
        ]
      },
      "Movement": {
        "type": "object",
        "properties": {
          "lote_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "tipo": {
            "enum": [
              "entrada",
              "salida"
            ]
          },
          "cantidad": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "referencia": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "motivo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "saldo_posterior": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "replayed": {
            "type": "boolean"
          },
          "lote": {
            "$ref": "#/components/schemas/Lot"
          }
        },
        "required": [
          "id",
          "fecha",
          "saldo_posterior",
          "lote_id",
          "tipo",
          "cantidad",
          "referencia",
          "motivo"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "productos": {
            "type": "integer"
          },
          "lotes": {
            "type": "integer"
          },
          "valor": {
            "type": "number"
          },
          "alertas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "existencias": {
            "type": "object",
            "properties": {
              "kg": {
                "type": "number"
              },
              "l": {
                "type": "number"
              },
              "unidad": {
                "type": "number"
              }
            }
          },
          "movimientos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          },
          "database": {
            "const": "MongoDB"
          },
          "modo": {
            "type": "string"
          }
        }
      }
    }
  }
}