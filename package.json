{
  "name": "by-fekas-erp-sdd",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "ng": "ng",
    "start": "node server/start.mjs",
    "dev": "concurrently -k -n API,ANGULAR \"node server/start.mjs\" \"ng serve --proxy-config proxy.conf.json\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node --test server/tests/*.test.mjs",
    "test:ui": "ng test --watch=false",
    "test:integration": "node --test server/tests/integration/*.test.mjs",
    "lint": "eslint src server scripts && tsc -p tsconfig.app.json --noEmit",
    "verify": "npm run lint && npm test && npm run build && npm run test:integration"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "concurrently": "^9.2.0"
  }
}
